package test1;

import org.testng.annotations.AfterClass;
import org.testng.annotations.AfterMethod;
import org.testng.annotations.AfterSuite;
import org.testng.annotations.AfterTest;
import org.testng.annotations.BeforeClass;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.BeforeSuite;
import org.testng.annotations.BeforeTest;

public class PrePostAnnoatations {
  
  @BeforeTest
  public void BeforeTestExecute() {
	  System.out.println("This will execute before test");
  }
  
  @AfterTest
  public void AfterTestExecute() {
	  System.out.println("This will execute after test");
  }


	@BeforeClass
	public void BeforeClassExecute() {
		  System.out.println("This will execute before class");
	}
	
	@AfterClass
	public void AfterClassExecute() {
		  System.out.println("This will execute after class");
	}

	@BeforeMethod
	public void BeforeMethodExecute() {
		  System.out.println("This will execute before method");
	}
	
	@AfterMethod
	public void AfterMethodExecute() {
		  System.out.println("This will execute after method");
	}
	
	@BeforeSuite
	public void BeforeTestSuite() {
		  System.out.println("This will execute before test suite");
	}
	
	@AfterSuite
	public void AfterTestSuite() {
		  System.out.println("This will execute after test suite");
	}
	
	
	
}
